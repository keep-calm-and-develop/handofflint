# Figma REST API (server-side only — never expose to the client)
FIGMA_ACCESS_TOKEN=

# Server-side in-memory cache for Figma file trees (version-validated via /meta).
FIGMA_CACHE_ENABLED=true
# FIGMA_CACHE_TTL_MS=900000
# FIGMA_CACHE_FRESH_MS=30000
# FIGMA_CACHE_MAX_ENTRIES=50

# OpenRouter — for AgentMark orchestrator (Week 2+)
OPENROUTER_API_KEY=
