# Figma REST API (server-side only — never expose to the client)
FIGMA_ACCESS_TOKEN=

# Serve Figma file tree responses from example.json via MSW (dev only).
# Requires a non-empty FIGMA_ACCESS_TOKEN. Cache is auto-disabled while mock is on.
FIGMA_API_MOCK=true

# Server-side in-memory cache for raw Figma API responses (version-validated via /meta).
FIGMA_CACHE_ENABLED=true
# FIGMA_CACHE_TTL_MS=900000
# FIGMA_CACHE_FRESH_MS=30000
# FIGMA_CACHE_MAX_ENTRIES=50

# Upstash Redis — flat index for wizard pipeline (init → audit → vision).
# When unset, flat index falls back to in-process memory (local dev / Vitest).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenRouter — for AgentMark orchestrator (Week 2+)
OPENROUTER_API_KEY=
