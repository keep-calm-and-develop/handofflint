# Figma REST API (server-side only — never expose to the client)
FIGMA_ACCESS_TOKEN=

# Dev default: use ./example.json instead of the API (no rate limits).
# Set to false to call the real Figma API in development.
FIGMA_USE_FIXTURE=true
# FIGMA_FIXTURE_PATH=./example.json

# OpenRouter — for AgentMark orchestrator (Week 2+)
OPENROUTER_API_KEY=
